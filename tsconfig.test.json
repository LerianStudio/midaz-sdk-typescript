    "tests/models/transaction.test.ts", // 41
    "tests/entities/implementations/transactions-impl.test.ts", // 12
    "tests/models/asset.test.ts", // 10
    "tests/util/http-client.test.ts", // 6
    "tests/api/http/http-transaction-api-client.test.ts", // 6
    "tests/integration/client.integration.test.ts", // 4
    "tests/setup.ts", // 3
    "tests/api/http/http-transaction-api-client-idempotency.test.ts", // 3
    "tests/util/cache.test.ts", // 1, and it is what makes src/util/cache/cache.ts report TS2428
    "tests/models/account.test.ts", // 1
    "tests/entities/implementations/operations-impl.test.ts", // 1
    "tests/client-config-builder.test.ts", // 1
    "tests/api/http/http-operation-api-client.test.ts" // 1
